# Server Configuration
SECRET_KEY=django-insecure-orqestra-dev-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,server
ALLOWED_CORS_DOMAINS=http://localhost:8080
DEBUG=True

# Database Configuration
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Client Configuration
VITE_API_URL=http://localhost:3001

# Agent Configuration
#
# Model choice and API keys are NOT set here any more. They belong to an
# organisation and are managed in the app: Settings -> AI Models. The values
# below are operator-level safety limits an org admin cannot raise.
AGENT_MAX_TURNS=20                    # model turns one request may take
AGENT_MAX_OUTPUT_TOKENS=8192          # cap on a single turn's output
AGENT_REQUEST_TIMEOUT=120             # seconds to wait on a hosted provider
OLLAMA_READ_TIMEOUT=300               # local models are slow; be generous
AGENT_RUN_STALE_MINUTES=10            # when an abandoned run is retired
